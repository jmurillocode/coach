# ─── App ────────────────────────────────────────────────────────────────────
# A single passcode that gates the whole app (single-user). Pick something long.
APP_PASSCODE="change-me-to-a-long-random-string"
# Base URL of the deployed app (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Supabase ───────────────────────────────────────────────────────────────
# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key — server-only, NEVER exposed to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Name of the Storage bucket for food photos (create it in Supabase)
SUPABASE_FOOD_BUCKET="food-photos"

# ─── Anthropic (Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
# Model used for coaching + food-photo vision
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─── Whoop OAuth ────────────────────────────────────────────────────────────
# From developer.whoop.com → your app
WHOOP_CLIENT_ID="your-whoop-client-id"
WHOOP_CLIENT_SECRET="your-whoop-client-secret"
# Must exactly match the redirect registered in the Whoop app:
#   {NEXT_PUBLIC_APP_URL}/api/whoop/callback
WHOOP_REDIRECT_URI="http://localhost:3000/api/whoop/callback"

# ─── Cron ───────────────────────────────────────────────────────────────────
# Secret that protects /api/cron/* — Vercel cron sends it as a Bearer token
CRON_SECRET="another-long-random-string"

# ─── Garmin (Phase 2 — leave blank for now) ─────────────────────────────────
# Unofficial worker writes directly to Supabase; official API creds go here later
GARMIN_EMAIL=""
GARMIN_PASSWORD=""
